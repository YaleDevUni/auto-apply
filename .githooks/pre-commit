#!/bin/sh
# 이 저장소에서 심볼릭 링크를 커밋하지 못하게 막는다.
#
# ## 왜 이게 필요한가 (2026-08-17 사고)
#
# 워크트리에서 검증을 돌리려고 저장소 뿌리에 `data`·`profile`·`.venv`
# 심볼릭 링크를 만들었다. .gitignore에는 `data/`·`profile/`·`.venv/`가 있었는데
# **끝의 슬래시는 디렉터리만 매칭한다** — git에게 심볼릭 링크는 디렉터리가
# 아니다. 그래서 `git add -A`가 셋을 그대로 추적했고 모든 커밋에 실려 갔다.
#
# 그 브랜치를 main에 병합하는 순간 git이 그 링크들을 진짜 디렉터리 자리에
# 체크아웃했고, **그 자리에 있던 디렉터리는 ignore 대상이라 경고 없이
# 지워졌다.** jobs.db(공고 4109건 + 중복지원 원장), 브라우저 로그인 세션,
# 이력서 원본(profile/resume/*.md)이 통째로 날아갔다. Time Machine도
# APFS 스냅샷도 없어서 이력서 원본은 못 살렸다.
#
# .gitignore에 슬래시 없는 패턴을 나란히 넣어 두긴 했지만(1차 방어선),
# 그건 규칙을 고치면 다시 뚫린다. 이 훅이 2차 방어선이다.
#
# ## 왜 심볼릭 링크를 아예 막나
#
# 이 저장소에 심볼릭 링크가 필요한 정당한 이유가 없다 — 코드만 담는 저장소다.
# "바깥 디렉터리를 저장소 안에서 보이게 하고 싶다"는 요구는 전부
# **AUTOAPPLY_HOME 환경변수**로 해결된다(src/autoapply/paths.py). 그쪽은
# 작업 트리를 아예 안 건드리므로 이 사고가 구조적으로 불가능하다.
#
#     워크트리에서 검증할 때:
#       AUTOAPPLY_HOME=/Users/<you>/auto-apply .venv/bin/python cli.py status
#
# 정말 필요하면 `git commit --no-verify`로 넘길 수 있다. 넘기기 전에
# 위 문단을 다시 읽을 것.

set -e

fail=0

# ── 1. 스테이지에 올라온 심볼릭 링크 (모드 120000) ────────────────────
links=$(git diff --cached --raw --diff-filter=ACMR | awk '$2 == "120000" { print $NF }')
if [ -n "$links" ]; then
    echo "커밋 거부 — 심볼릭 링크가 스테이지에 있습니다:" >&2
    echo "$links" | sed 's/^/  /' >&2
    echo "" >&2
    echo "  이 저장소는 코드만 담습니다. 바깥 디렉터리를 붙이려면 링크가 아니라" >&2
    echo "  AUTOAPPLY_HOME 환경변수를 쓰세요 — 작업 트리를 안 건드립니다." >&2
    echo "    AUTOAPPLY_HOME=/path/to/instance .venv/bin/python cli.py status" >&2
    echo "" >&2
    echo "  2026-08-17에 이 자리에서 jobs.db와 이력서 원본이 날아갔습니다." >&2
    echo "  자세한 내용은 .githooks/pre-commit 주석을 읽으세요." >&2
    fail=1
fi

# ── 2. 개인 데이터 경로는 어떤 형태로도 추적하지 않는다 ────────────────
#
# 링크가 아니라 진짜 파일로 넣어도 막는다. data/ 안에는 텔레그램 봇 토큰과
# 지원 증적(이름·이메일·전화번호)이, profile/ 안에는 로그인 세션과
# credentials.json이 들어 있다 — 한 번 올라가면 되돌릴 수 없다.
private=$(git diff --cached --name-only --diff-filter=ACMR \
          | grep -E '^(data|profile|\.venv)(/|$)' || true)
if [ -n "$private" ]; then
    echo "커밋 거부 — 개인 데이터/환경 경로가 스테이지에 있습니다:" >&2
    echo "$private" | sed 's/^/  /' >&2
    echo "" >&2
    echo "  data/ 에는 봇 토큰과 지원 증적이, profile/ 에는 로그인 세션과" >&2
    echo "  credentials.json 이 있습니다. 올라가면 되돌릴 수 없습니다." >&2
    echo "    git rm --cached <경로>" >&2
    fail=1
fi

exit $fail
