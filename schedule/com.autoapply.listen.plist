<?xml version="1.0" encoding="UTF-8"?>
<!--
  텔레그램 상시 대기 (launchd)

  사이클(2시간마다)에서만 받아오면 답장이 최대 2시간 밀린다. 실제로 그랬다.
  이 에이전트는 롱폴링으로 항상 붙어 있어 폰에서 보낸 명령에 즉시 답한다.

  유휴 비용이 거의 없다 — 연결 하나를 열어두고 서버가 새 메시지를 밀어줄 때까지
  기다리는 방식이라, 폴링 간격을 줄이는 것과 다르다.

  KeepAlive: 죽으면 다시 띄운다. 맥이 잠들거나 네트워크가 끊기는 일이 잦다.
  ThrottleInterval: 재시작 폭주를 막는다.

  PATH: 이 리스너가 subprocess.Popen으로 띄우는 모든 서브프로세스(/guide,
  /지원시작, /improve, 수정요청 재작성)가 PATH를 그대로 물려받는다. launchd
  기본 PATH엔 claude CLI가 없어서, 예전에 그것들이 "claude CLI를 찾을 수 없다"로
  조용히(stdout/stderr가 DEVNULL이라) 죽었다 — 실제로 /guide 요청 하나가
  이렇게 사라졌다. 실제 export는 listen.sh가 하고, 여기 값은 그와 같게 둔 이중
  안전장치다.

  ProgramArguments[0]이 `.venv/bin/python`이 **아니라** `/bin/bash`인 이유:
  2026-08-17에 `.venv`가 없는 상태로 이 잡이 bootstrap 되자 launchd의 스폰이
  ENOENT로 실패했다. 그러면 `last exit code = 78: EX_CONFIG`만 남고 stdout/stderr
  로그는 0바이트다 — 프로세스가 안 떴으니 쓸 주체가 없다. 로그만 봐서는 "조용히
  잘 돌고 있다"와 구분되지 않았다. 게다가 `.venv`가 4분 뒤 돌아왔는데도
  KeepAlive가 못 살렸다(`runs = 418`, kickstart도 안 통하고 bootout+bootstrap이라야
  살아남). 6시간 동안 폰 명령 4건이 응답 없이 사라졌다.
  `/bin/bash`는 없어지지 않는다. listen.sh가 한 겹 받으면 무엇이 없든 로그에
  글자가 남고, 감시자(com.autoapply.watchdog)가 그걸 보고 알린다.

  설치: schedule/install.sh
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.autoapply.listen</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__REPO__/schedule/listen.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__REPO__/data/logs/listen.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/data/logs/listen.err.log</string>
</dict>
</plist>
