<?xml version="1.0" encoding="UTF-8"?>
<!--
  텔레그램 상시 대기 (launchd)

  사이클(2시간마다)에서만 받아오면 답장이 최대 2시간 밀린다. 실제로 그랬다.
  이 에이전트는 롱폴링으로 항상 붙어 있어 폰에서 보낸 명령에 즉시 답한다.

  유휴 비용이 거의 없다 — 연결 하나를 열어두고 서버가 새 메시지를 밀어줄 때까지
  기다리는 방식이라, 폴링 간격을 줄이는 것과 다르다.

  KeepAlive: 죽으면 다시 띄운다. 맥이 잠들거나 네트워크가 끊기는 일이 잦다.
  ThrottleInterval: 재시작 폭주를 막는다.

  EnvironmentVariables/PATH: 이 잡은 run.sh를 안 거치고 launchd가 python을
  바로 띄운다. launchd 기본 PATH엔 claude CLI가 없어서, 이 리스너가
  subprocess.Popen으로 띄우는 모든 서브프로세스(/guide, /지원시작, /improve,
  수정요청 재작성)가 PATH를 그대로 물려받아 "claude CLI를 찾을 수 없다"로
  조용히(stdout/stderr가 DEVNULL이라) 죽었다 — 실제로 /guide 요청 하나가
  이렇게 사라졌다. run.sh가 스스로 export하는 PATH와 그대로 맞춘다.

  설치: schedule/install.sh
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.autoapply.listen</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/python</string>
        <string>__REPO__/cli.py</string>
        <string>listen</string>
        <string>--watch</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__REPO__/data/logs/listen.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/data/logs/listen.err.log</string>
</dict>
</plist>
