<?xml version="1.0" encoding="UTF-8"?>
<!--
  autoapply 정기 실행 (launchd)

  하루 세 번 돈다. 한 번이 아닌 이유:

    03:00  지원 상한(max_per_day)이 자정에 리셋된 직후. 밤새 올라온 공고를 잡는다.
    09:00  아침에 올라오는 공고. 마감 임박 건이 여기서 걸린다.
    15:00  Claude 사용 한도에 걸려 03시·09시가 중간에 멈췄을 때 이어받는 자리.

  UsageLimited로 멈춘 실행은 실패가 아니다. 자리를 놓아주고 조용히 끝내므로
  다음 실행이 같은 공고를 이어서 처리한다. 그래서 재시도 로직 대신 스케줄을
  여러 번 두는 쪽이 단순하고 확실하다.

  RunAtLoad를 끈 이유: 맥북을 열 때마다 돌면 예측이 안 된다.
  맥이 잠들어 그 시각을 놓치면 launchd가 깨어난 직후 한 번 실행해 준다.

  설치:  schedule/install.sh
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.autoapply.cycle</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/schedule/run.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO__/data/logs/cycle.out.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/data/logs/cycle.err.log</string>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>
</dict>
</plist>
